# Copy this file to .env.local and fill in real values.
# DO NOT commit .env.local to git. Never prefix secrets with NEXT_PUBLIC_.

# --- Required ---------------------------------------------------------------
OPENAI_API_KEY=sk-...
# Optional: API base URL supplied by Vocareum (leave empty for OpenAI directly)
OPENAI_BASE_URL=
# Optional model overrides
CHAT_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# Upstash Vector: the library index (namespace "investment-research-library")
UPSTASH_VECTOR_REST_URL=https://...-vector.upstash.io
UPSTASH_VECTOR_REST_TOKEN=...

# --- Recommended before going public -----------------------------------------
# Upstash Redis (a separate database): daily question limits.
# REQUIRED in production: without it the chat API refuses questions (503) so
# nobody can run up your OpenAI bill. Limits are skipped in `npm run dev`.
UPSTASH_REDIS_REST_URL=https://...upstash.io
UPSTASH_REDIS_REST_TOKEN=...
# Any long random string (e.g. from a password manager); used to hash visitor
# IP addresses so they can't be reversed. Set it before going live.
IP_HASH_SALT=
# Only for testing a production build locally without Redis. Never set on Vercel.
# ALLOW_NO_RATE_LIMIT=true

# --- Optional: accounts (Clerk). Without these the site runs free and anonymous.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# --- Optional: payments (Stripe). Needs Clerk as well.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_BASIC=
STRIPE_PRICE_PREMIUM=
STRIPE_PRICE_PRO=
# Charge GST through Stripe Tax (only once you're GST-registered and Stripe Tax is set up)
STRIPE_AUTOMATIC_TAX=false
NEXT_PUBLIC_SITE_URL=https://your-domain
